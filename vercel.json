{
  "rewrites": [
    {
      "source": "/noticias",
      "destination": "/noticias.html"
    },
    {
      "source": "/noticias/:slug",
      "destination": "/api/noticia?slug=:slug"
    },
    {
      "source": "/sitemap-noticias.xml",
      "destination": "/api/sitemap-noticias"
    },
    {
      "source": "/cabimas-y-su-gente",
      "destination": "/cabimas-y-su-gente.html"
    },
    {
      "source": "/cabimas-y-su-gente/ejemplo",
      "destination": "/cabimas-resena-ejemplo.html"
    },
    {
      "source": "/cabimas-y-su-gente/talento-venezolano-new-york-fashion-week",
      "destination": "/cabimas-nyfw-2026.html"
    }
  ],
  "functions": {
    "api/noticia.js": {
      "includeFiles": "noticias.html"
    },
    "api/ads.js": {
      "includeFiles": "ads/config.json"
    }
  }
}
